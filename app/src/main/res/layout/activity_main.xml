<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <!-- 0.2.9: schwarz, ~halb so hoch wie 56 dp – mehr Fläche für die Seite. -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@color/toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="2dp"
        android:paddingStart="2dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_bg"
            android:contentDescription="@string/cd_back"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back" />

        <ImageView
            android:id="@+id/btn_forward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_bg"
            android:contentDescription="@string/cd_forward"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_forward" />

        <ImageView
            android:id="@+id/btn_reload"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_bg"
            android:contentDescription="@string/cd_reload"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_reload" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/lbl_version"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/version_badge_bg"
            android:contentDescription="@string/cd_version"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="—"
            android:textColor="@color/version_badge_text"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_zoom_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_bg"
            android:contentDescription="@string/cd_zoom_toggle"
            android:gravity="center"
            android:text="Aa"
            android:textColor="@color/icon"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_zoom_out"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_bg"
            android:contentDescription="@string/cd_zoom_out"
            android:gravity="center"
            android:text="A−"
            android:textColor="@color/icon"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_zoom_in"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_bg"
            android:contentDescription="@string/cd_zoom_in"
            android:gravity="center"
            android:text="A+"
            android:textColor="@color/icon"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_bg"
            android:contentDescription="@string/cd_menu"
            android:gravity="center"
            android:text="⋮"
            android:textColor="@color/icon"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/toolbar_border" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_horizontal" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
